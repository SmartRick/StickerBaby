{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "贴纸宝宝",
  "mainBinaryName": "deskpet",
  "version": "0.1.0",
  "identifier": "com.deskpet.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$EXE/data/stickers/**",
          "$EXE/data/models/*.onnx",
          "$APPLOCALDATA/stickers/**",
          "$APPLOCALDATA/models/*.onnx"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
